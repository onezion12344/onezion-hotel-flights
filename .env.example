# onezion-hotel-flights 环境变量配置
# 复制本文件为 .env 并填入你的 API Key

# AIGoHotel MCP - 国内酒店搜索首选
# 申请: https://mcp.agentichotel.cn/apply
AIGOHOTEL_API_KEY=

# Jinko MCP - 全球200万+酒店，支持预订
# 申请: https://www.jinko.so/
JINKO_API_KEY=

# Booking.com MCP - 通过 RapidAPI 接入
# 申请: https://rapidapi.com/apidojo/api/booking-com/
RAPIDAPI_KEY=

# 高德地图 API - POI 定位辅助
# 申请: https://lbs.amap.com/api/webservice/guide/create-project/get-key
AMAP_API_KEY=
